# Copy this file to .env and fill in your key. Never commit .env.
# Free key: https://aistudio.google.com/apikey
# Note: on the Gemini free tier, Google may use prompts to improve its products.
# FinEdvise replaces student and guardian names and phone numbers with codes before any call.
GEMINI_API_KEY=

# Models to try in order (the next one is used if a model is busy or not available to your key)
FINEDVISE_GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Set to 1 only after the app is served over HTTPS by a correctly configured reverse proxy.
FINEDVISE_COOKIE_SECURE=0

# Optional live Google references (Programmable Search Engine).
# Create a Custom Search Engine and API key before enabling web research.
# FINEDVISE_GOOGLE_CSE_API_KEY=
# FINEDVISE_GOOGLE_CSE_CX=
# Shared judge credentials are public. Do not enable this on an internet-facing deployment.
# FINEDVISE_ENABLE_DEMO_ACCOUNT=0 disables demo; it is enabled by default on loopback only.
